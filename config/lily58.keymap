#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define default_layer 0
#define lower_layer 1
#define raise_layer 2
#define adjust_layer 3
#define extra 4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC              &kp N1       &kp N2      &kp N3      &kp N4       &kp N5                                                   &kp N6  &kp N7       &kp N8      &kp N9      &kp N0          &kp BSPC
&kp TAB              &kp Q        &kp W       &kp E       &kp R        &kp T                                                    &kp Y   &kp U        &kp I       &kp O       &kp P           &kp PIPE
&mt LEFT_SHIFT CAPS  &mt LCTRL A  &mt LALT S  &mt LGUI D  &mt LSHFT F  &kp G                                                    &kp H   &mt LSHFT J  &mt RGUI K  &mt RALT L  &mt RCTRL SEMI  &kp RET
&kp LEFT_CONTROL     &kp Z        &kp X       &kp C       &kp V        &kp B   &mt CAPSLOCK LC(LEFT)    &mt CAPSLOCK RC(RIGHT)  &kp N   &kp M        &kp COMMA   &kp DOT     &kp FSLH        &kp RSHFT
                                              &kp LALT    &kp LGUI     &mo 1   &kp SPACE                &kp SPACE               &mo 2   &kp RGUI     &kp RALT
            >;
        };

        lower_layer {
            display-name = "symbol";

            // ------------------------------------------------------------------------------------------------------------
            // | F1    |  F2  |  F3  |  F4   |  F5   |  F6   |                   |  F7   |   F8   |   F9   |  F10  |   F11  |   F12  |
            // |  `    |  !   |  @   |  #    | $    |  %    |                   |  ^    |   &    |   *  |  (   |   )    |  HOME  |
            // |       |      |      |      |      |      |                   |       |        |        |      |        |  END   |
            // |       |      |      |      |      |      |   (    |  |  )    |  +    |  -     |   *    |  /   |  PG_UP | PAGE_DOWN |
            //                     |      |      |   2 |        |  |       |   0   |       |

            bindings = <
&kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN  &kp POUND  &kp DOLLAR  &kp PERCENT                                &kp CARET  &kp AMPERSAND  &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DELETE
&trans     &trans           &trans       &trans     &trans      &trans                                     &trans     &trans         &trans         &kp LEFT_BRACKET      &kp RBKT               &kp PIPE
&trans     &trans           &trans       &trans     &trans      &trans                                     &trans     &trans         &trans         &trans                &trans                 &trans
&trans     &trans           &trans       &trans     &trans      &trans       &kp PAGE_UP    &kp PAGE_DOWN  &trans     &trans         &kp LESS_THAN  &kp GREATER_THAN      &kp QUESTION           &trans
                                         &trans     &trans      &trans       &trans         &trans         &trans     &trans         &trans
            >;
        };

        raise_layer {
            display-name = "Number";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |       |     |      |      |      |      |                  |      |       |   UP  |      |       |       |
            // |       |     |      |      |      |      |                  |      |  LEFT |  DOWN | RIGHT|       |       |
            // |       |     |      |      |      |      |                  |      |       |       |      |       |       |
            //                     |      |      |  3   |        |  |       |  1   |       |

            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                    &kp F7          &kp F8    &kp F9    &kp F10    &kp F11   &kp F12
&trans  &trans  &trans  &trans  &trans  &trans                    &msc SCRL_UP    &trans    &kp UP    &trans     &kp HOME  &kp PAGE_UP
&trans  &trans  &trans  &trans  &trans  &trans                    &msc SCRL_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp END   &kp PAGE_DOWN
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans    &trans    &trans     &trans    &trans
                        &trans  &trans  &trans  &trans    &trans  &trans          &trans    &trans
            >;
        };

        extra {
            display-name = "Mouse";

            // ------------------------------------------------------------------------------------------------------------
            // |  BT_CLR_ALL | BT_SEL 0 | BT_SEL 1 | BT_SEL 2 | BT_SEL 3 | BT_SEL 4 |                   |       |       |       |       |       |       |
            // |             |          |          |          |          |          |                   |       |       | MOVE_UP|       |       |       |
            // |             | MOVE_LEFT| MOVE_DOWN| MOVE_RIGHT|          |          |                   | SCRL_DOWN|MOVE_LEFT|MOVE_DOWN|MOVE_RIGHT|       |       |
            // |             |          |          |          |          |          |   SCRL_UP |  LCLK | RCLK | SCRL_UP |
            //                     |          |  TO 0  |        |   LCLK |  TO 2  |   RCLK |

            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4                         &trans          &trans          &trans          &trans           &trans  &trans
&trans  &trans          &mmv MOVE_UP    &trans           &trans        &trans                               &trans          &trans          &mmv MOVE_UP    &trans           &trans  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans        &msc SCRL_DOWN                       &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans          &trans          &trans           &trans        &msc SCRL_UP    &trans    &trans     &msc SCRL_UP    &trans          &trans          &trans           &trans  &trans
                                        &trans           &trans        &to 0           &trans    &mkp LCLK  &to 3           &mkp RCLK       &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        to3 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
